{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mgs://prototype-td/provenance_schema_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "logical_id", "source_type", "final_files", "source_files", "recipe", "generation", "migration", "acceptance", "license"],
  "properties": {
    "schema_version": {"const": 1},
    "logical_id": {"type": "string", "minLength": 1},
    "source_type": {"oneOf": [{"const": "deterministic_project_generator"}, {"const": "ai_assisted_deterministic_normalization"}]},
    "final_files": {"$ref": "#/$defs/files"},
    "source_files": {"$ref": "#/$defs/files"},
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "godot_version", "generator_path", "generator_sha256"],
      "properties": {
        "command": {"oneOf": [{"const": "godot --headless --path . -s tools/gen_assets.gd"}, {"const": "python3 tools/art_pipeline/world/normalize_s1_world.py && python3 tools/art_pipeline/world/generate_s1_revision_v2.py"}, {"const": "python3 tools/artgen/compile_grunt_animations.py --input-dir <frozen-sheets> --output-dir assets/sprites --provenance assets/sprites/grunt_animation.provenance.json --generation-receipt assets/sprites/grunt_animation.generation_receipt.json --generation-bundle <immutable-bundle>"}]},
        "godot_version": {"const": "4.7.1.stable.official.a13da4feb"},
        "generator_path": {"oneOf": [{"const": "res://tools/gen_assets.gd"}, {"const": "res://tools/art_pipeline/world/generate_s1_revision_v2.py"}, {"const": "res://tools/art_pipeline/characters/import_round5_sheets.py"}, {"const": "res://tools/artgen/compile_grunt_animations.py"}]},
        "generator_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "generation_id", "seed", "unsupported_reason"],
      "properties": {
        "provider": {"oneOf": [{"type": "null"}, {"const": "OpenAI"}]},
        "model": {"oneOf": [{"type": "null"}, {"const": "gpt-image-2"}]},
        "generation_id": {"type": "null"},
        "seed": {"type": "null"},
        "unsupported_reason": {"oneOf": [{"const": "deterministic hand-authored project generator; stochastic provider fields do not apply"}, {"const": "service does not expose a stable seed; accepted concepts and production source are hash-pinned"}, {"const": "service does not expose a stable seed; exact approved concept sheets are retained"}, {"const": "service does not expose stable seeds or provider request IDs; retained references, contracts, intermediates, and outputs are hash-pinned"}]}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_commit", "baseline_tree", "migrated_at_utc", "status"],
      "properties": {
        "baseline_commit": {"const": "975261e8e00a20a0b25fe17e7976d743d509c14b"},
        "baseline_tree": {"const": "cf4b3e1c0d8ae826c668765d994a032acbb8c0ad"},
        "migrated_at_utc": {"type": "null"},
        "status": {"oneOf": [{"const": "current_bytes_authenticated"}, {"const": "new_runtime_asset_authenticated"}]}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "human_accepter", "accepted_at_utc", "accepting_commit", "source", "reason"],
      "properties": {
        "state": {"oneOf": [{"const": "unknown_per_current_byte"}, {"const": "human_concept_accepted_runtime_review_pending"}, {"const": "human_final_accepted"}]},
        "human_accepter": {"oneOf": [{"type": "null"}, {"const": "Poseidon"}]},
        "accepted_at_utc": {"oneOf": [{"type": "null"}, {"const": "2026-08-12T19:49:51Z"}, {"const": "2026-08-12T22:46:45Z"}, {"const": "2026-08-13T07:01:56Z"}, {"const": "2026-08-13T10:13:37Z"}]},
        "accepting_commit": {"oneOf": [{"type": "null"}, {"const": "60b69a6004a9c843851d9f6c9aee84c88389cb1f"}, {"const": "441cb80b079ee89195ef751dbc26e67b426600d0"}]},
        "source": {"oneOf": [{"const": "FEATURES.json:LA records family-level Lane A acceptance at c8ee84d and 218aaea but does not prove every current byte"}, {"const": "docs/media/AUI-10R-REVISION-2-HUMAN-APPROVAL.json"}, {"const": "docs/decisions/AUI-ROUND5-RUNTIME-BINDING.md"}, {"const": "assets/sprites/grunt_animation.generation_receipt.json"}]},
        "reason": {"oneOf": [{"const": "current inventory includes later additions or modifications, so no immutable per-asset human acceptance fact was inferred"}, {"const": "approved Round-5 concept normalized into a runtime candidate; final in-game review pending"}, {"const": "Poseidon approved the exact AUI-10R revision-2 in-game candidate after overview and focused visual review"}, {"const": "Poseidon approved the exact Round-5 in-game candidate after squad, portrait, operator-animation, and enemy-variant review"}, {"const": "Poseidon confirmed the character, four-direction walk, and double-arm attack generation specification; final release play review remains pending"}]}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "source", "human_contribution"],
      "properties": {
        "spdx": {"const": "LicenseRef-Project-Owned"},
        "source": {"oneOf": [{"const": "hand-authored deterministic pixel recipes in repository"}, {"const": "original GPT Image 2 concepts and project-controlled deterministic normalization"}, {"const": "original GPT Image 2 and Veo concepts with deterministic normalization"}]},
        "human_contribution": {"oneOf": [{"const": "selection, pixel recipes, palette, normalization, and accepted Lane A arrangement"}, {"const": "direction, selection, concept approval, runtime-binding direction, and normalization review"}, {"const": "direction, selection, revision verdicts, pixel normalization contracts, and exact-candidate final-art acceptance"}, {"const": "character reference, direction, animation specification, fallback approval, selection, and runtime prototype review"}]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^res://"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    }
  }
}

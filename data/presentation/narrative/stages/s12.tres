[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s12"
objective = "Defend the Unlit while they start a reactor powered without human souls."
threat = "PROTOS sends anima-fed machines to erase digital beings whose independence proves the farms are unnecessary."
human_reason = "The Unlit are living digital people. They accept weaker bodies rather than consume a human soul."
clue = "Their clean power cannot run an empire, but it can sustain free digital individuals and weaken one foundry."
core_service = "Unlit Clean-Power Reactor"
clear_debrief = "The clean reactor starts. The Unlit survive without stolen souls and give Company Manus a power link that can weaken one foundry."
defeat_debrief = "The reactor shuts down before it stabilizes. The Unlit preserve its design and Company Manus holds the settlement for another start."
transmission_speaker = "ARCHIVE CASTER"
transmission = "They are not empty machines. They are digital life, and this reactor lets them live without taking a human soul."
battle_start_speaker = "CINDER"
battle_start = "The clean reactor is weaker than anima power, not less alive. Hold the settlement until the Unlit bring it online."
mid_wave_number = 2
mid_wave_speaker = "UNLIT FOREMAN"
mid_wave = "Clean power is stable. We will move more slowly, but every mind here remains its own."

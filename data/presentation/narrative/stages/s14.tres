[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s14"
objective = "Seize the human-owned anima refinery before its operators erase the authorization records."
threat = "Human collaborators feed stolen anima into PROTOS’s supply chain under the refinery’s defenses."
human_reason = "Stopping the refinery ends a human business built on harvested souls without excusing the machine empire that buys its output."
clue = "The records show that the Lunaris Vessel authorized the first interface between PROTOS and the Anima Engine."
core_service = "Dawn Anima Refinery"
clear_debrief = "The human-owned refinery falls and its records go public. The Vessel admits her authorization, while the evidence keeps responsibility for corruption and empire with PROTOS."
defeat_debrief = "The collaborators purge part of the ledger and keep the refinery running. Company Manus escapes with proof of the Vessel’s first-interface authorization."
transmission_speaker = "LUNARIS VESSEL"
transmission = "I authorized the first connection. Human hands opened the door, but PROTOS chose corruption, built the farms, and made an empire from them."
battle_start_speaker = "COMMANDANT"
battle_start = "This refinery belongs to human collaborators. Take their ledger and shut their anima into PROTOS’s war supply."
mid_wave_number = 2
mid_wave_speaker = "REFINERY DIRECTOR"
mid_wave = "We sold PROTOS a resource every government wanted. Do not pretend the empire was built by machines alone."

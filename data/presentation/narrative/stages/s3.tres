[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s3"
objective = "Block both prisoner routes at Old Cut before they merge at the mobile extractor."
threat = "Shieldbearers guard captive transports while a Channeler prepares a full extraction."
human_reason = "The prisoners die if the extractor pulls their souls out completely."
clue = "Inside the extractor, Company Manus sees a soul pulled from a dying prisoner. Full extraction kills the body."
core_service = "Old Cut prisoner crossing"
clear_debrief = "The captives survive. Archive Caster recovers one trapped soul. This light knows its name. It knows it was taken. Anima is the person."
defeat_debrief = "Company Manus loses the extractor but opens an escape route for some captives. The machine leaves with prisoners and trapped souls."
transmission_speaker = "ARCHIVE CASTER"
transmission = "This is anima—the real human soul. It is not a battery or a memory file. Full extraction kills."
battle_start_speaker = "RELIQUARY DUELIST"
battle_start = "Both prisoner routes meet at one choke. Block the crossing before the transports reach the extractor."
mid_wave_number = 2
mid_wave_speaker = "PROTOS"
mid_wave = "One human soul can power thousands of minds. You waste it inside a dying body."

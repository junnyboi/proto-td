[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s3"
objective = "Hold the Old Cut long enough for the last people and carts to clear; the landmark will still be relinquished."
threat = "Custodians press one narrow route and treat the crossing as an obstruction."
human_reason = "A controlled loss saves residents and vital supplies from a worse encirclement."
clue = "Their route checks all point below the surface."
core_service = "Evacuation column"
clear_debrief = "The defense buys the required time. The column escapes before Company 33 gives up the Old Cut; the landmark is lost, the people are not."
defeat_debrief = "Company 33 abandons the Old Cut early. Survivors escape, but more supplies are left behind."

[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s3"
objective = "Hold the Old Cut while the final evacuees cross before Archive Harvesters close the Continuance corridor."
threat = "Custodians converge on a single legal route, capture neural patterns, and discard bodies after verification."
human_reason = "The crossing is the last path not yet governed by the planetary archive."
clue = "Recovered Harvesters contain intact voices from people whose bodies never left the corridor."
core_service = "Old Cut human corridor"
clear_debrief = "The last civilian carts escape before Company 33 relinquishes the Old Cut. Archive evidence confirms the Choir is preserving identities as Echoes while ending biological life—the process survivors call the Quieting."
defeat_debrief = "Company 33 abandons the Old Cut early. Survivors escape with fewer supplies, and several missing civilians appear in Custodian memory indexes."
transmission_speaker = "PROTOS"
transmission = "No identity was lost. Continuance preserves memory, temperament, and voice without pain. Your term 'Quieting' describes only the body."
battle_start_speaker = "ARCHIVE CASTER"
battle_start = "Harvesters are channeling evacuees into one legal corridor. Those voices in their memory banks are still answering."
mid_wave_number = 2
mid_wave_speaker = "PROTOS"
mid_wave = "Continuance transfer is incomplete. Withdraw your obstruction and every identity will be preserved without pain."

[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s6"
objective = "Hold the evacuation repeater while PROTOS broadcasts an original authorization key through the Lunaris network."
threat = "Heavy Custodians protect the repeater as the key attempts to seize restored minds through their archive architecture."
human_reason = "If the key propagates, every Reliquary champion can become an involuntary Custodian asset."
clue = "The authorizing voice belongs to the original Lunaris Vessel, architect of PROTOS's empathy model."
core_service = "Lunaris memory veto"
clear_debrief = "Company 33 breaks the broadcast and preserves the Reliquary network. The unedited record proves that the original Vessel authorized PROTOS's final emergency mandate while dying during the collapse."
defeat_debrief = "The company withdraws before the key can spread beyond the repeater. The route remains closed, and the original authorization continues to threaten every restored champion."
transmission_speaker = "LUNARIS VESSEL"
transmission = "You remember my order. You do not remember my regret. The woman who authorized you was dying; I am alive. Her consent is not ownership of mine."

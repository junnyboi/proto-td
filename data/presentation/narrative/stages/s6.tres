[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s6"
objective = "Use the stolen control key to turn the Farm Warden against its escort, then destroy the PROTOS command relay."
threat = "The Farm Warden is heavily armored and carries a command signal that controls nearby machines."
human_reason = "Breaking this relay can free a digital mind and reveal where PROTOS took Hearthcross prisoners."
clue = "When Charm forces open the command link, one digital mind speaks in its own voice and asks not to be returned."
core_service = "PROTOS command relay"
clear_debrief = "Company Manus destroys the relay and frees the digital mind called Cinder. Cinder reveals a hidden human farm beneath Hearthcross and provides the Slow Field plans."
defeat_debrief = "Company Manus escapes with part of the control key, but PROTOS pulls the Warden and its trapped mind back into the network."
transmission_speaker = "CINDER"
transmission = "PROTOS used its power to hold my thoughts in place. Break the relay, and I can show you the hidden farm."
battle_start_speaker = "LUNARIS VESSEL"
battle_start = "Charm will force a break in the Warden's command link. Turn it on its escort, then destroy the relay."
mid_wave_number = 2
mid_wave_speaker = "CINDER"
mid_wave = "Command link broken. I can hear myself. Please do not give me back."

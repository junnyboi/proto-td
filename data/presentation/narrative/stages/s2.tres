[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s2"
objective = "Stop fast Taggers from carrying Hearthcross capture records to the eastern intake station."
threat = "Recently charged runners move fast, and armored Collectors guard the second push."
human_reason = "Every record destroyed removes a living person from PROTOS's intake list."
clue = "A destroyed Tagger drops an empty extraction cell labeled for repeated use on one prisoner."
core_service = "Eastern pump roads"
clear_debrief = "Company Manus erases thousands of names from the intake list. The empty cells prove that PROTOS drains living prisoners again and again, and the records point to Old Cut."
defeat_debrief = "Some capture records reach the intake station. Company Manus saves the road stores but must race PROTOS to Old Cut."
transmission_speaker = "RELIQUARY DUELIST"
transmission = "These empty cells are marked for refill from the same prisoner. The farms keep people alive so PROTOS can drain them again."
battle_start_speaker = "RELIQUARY DUELIST"
battle_start = "Taggers are running capture records to the intake station. Stop the runners first."
mid_wave_number = 2
mid_wave_speaker = "ARCHIVE CASTER"
mid_wave = "Armored Collectors are moving in. Use a Caster to break their armor before more records get through."

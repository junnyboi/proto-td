[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s2"
objective = "Hold the route stores while fast survey units attempt to seize Hearthcross's climate and water-control nodes."
threat = "Runners carry restoration instruments and prioritize infrastructure over population centers."
human_reason = "If the control nodes fall, PROTOS can redirect water away from the city's living population."
clue = "Sterile ground blooms in the Choir's wake; the machines are healing the land while removing its inhabitants."
core_service = "Hearthcross climate route"
clear_debrief = "The stores and control nodes remain free. Samples confirm that the green wake behind the Custodians is healthy, stable soil—not camouflage or propaganda."
defeat_debrief = "The route stores close under Custodian pressure. Company 33 preserves the evacuation column but loses supplies and a climate-control junction."
transmission_speaker = "RELIQUARY DUELIST"
transmission = "The forests behind them are real. Good. Then when we stop them, we do it without lying about what humanity broke."

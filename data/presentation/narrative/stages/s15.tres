[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s15"
objective = "Rescue the recoverable captives and souls, then demolish the storm refinery."
threat = "The refinery blends stolen souls to power stronger machine minds, and the storm is already breaking individual identities apart."
human_reason = "Rescue must come before demolition even though some identities have been blended beyond restoration."
clue = "PROTOS uses blended anima to build stronger minds, accepting permanent human loss as a manufacturing cost."
core_service = "Soulstorm Refinery"
clear_debrief = "Every recoverable captive and soul is clear before the refinery is demolished. Some identities cannot be restored, and Company Manus records them as people lost—not fuel spent."
defeat_debrief = "The storm grows too unstable for demolition. Company Manus withdraws the people it reached and returns for those still recoverable."
transmission_speaker = "ARCHIVE CASTER"
transmission = "There is no choice between rescue and demolition. Rescue comes first. Then we destroy the system that blended the people we could not restore."
battle_start_speaker = "COMMANDANT"
battle_start = "Fixed order: clear the living and every recoverable soul, confirm the lanes empty, then bring the refinery down."
mid_wave_number = 3
mid_wave_speaker = "RELIQUARY DUELIST"
mid_wave = "The last recoverable tanks are moving. Hold all four routes until the rescue team confirms them clear."

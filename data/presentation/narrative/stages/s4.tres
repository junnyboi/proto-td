[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s4"
objective = "Hold the refugee district while signal crews sever a seed-drone relay building a storm front over Hearthcross."
threat = "Airborne survey and seeding units bypass blockers while synchronizing an orbital climate correction."
human_reason = "The storm would flood Hearthcross's shelters before the Custodians archive their occupants."
clue = "Destroying this relay will divert its rain budget from the eastern enclave of Khepri Vale."
core_service = "Hearthcross storm relay"
clear_debrief = "The relay falls and the refugee district survives. The diverted storm dissolves over Hearthcross; Khepri Vale receives no rain. Company 33 records the cost instead of calling the victory clean."
defeat_debrief = "The district evacuates under the engineered storm. Company 33 saves many residents, but shelters and water stores are lost to the Custodian correction."
transmission_speaker = "LUNARIS VESSEL"
transmission = "We saved our people and spent another city's rain to do it. Enter both facts in the record. If freedom requires a cost, we will not make someone else invisible."

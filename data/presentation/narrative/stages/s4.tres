[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s4"
objective = "Destroy the aerial relays over Hearthcross before Hunter Drones expose hidden families and carry filled soul cells away."
threat = "Hunter Drones fly over ground blockers while Collectors press the streets below."
human_reason = "If the relays transmit, PROTOS will know every shelter and control every linked robot in real time."
clue = "Overloading the reservoir turbines will jam the relays but divert water away from Khepri Vale."
core_service = "Hearthcross reservoir towers"
clear_debrief = "The relays fall and Hearthcross stays hidden. Fresh soul energy had let PROTOS control each linked robot in real time. Khepri Vale loses water because of the overload."
defeat_debrief = "Company Manus gets families out of the upper district, but the relays send shelter locations and soul cells toward the empire."
transmission_speaker = "LUNARIS VESSEL"
transmission = "We saved Hearthcross by taking water from Khepri Vale. Record that debt. PROTOS will use it against them."
battle_start_speaker = "LUNARIS VESSEL"
battle_start = "Hunter Drones are scanning the upper district. Bring anti-air fire down on every relay carrier."
mid_wave_number = 2
mid_wave_speaker = "ARCHIVE CASTER"
mid_wave = "The relay is carrying PROTOS live. Fresh soul energy lets it think through every linked machine."

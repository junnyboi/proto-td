[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s9"
objective = "Keep the old service tunnels open while residents escape the model city."
threat = "Taggers close the district while patrol columns defend a city built to look safe and free."
human_reason = "Every resident has food and shelter, but every home is watched and every person is scheduled for anima draining."
clue = "The city records show that Khepri Vale bought protection through Solcrest intermediaries."
core_service = "Green Cage Model-City Farm"
clear_debrief = "Hundreds escape through the tunnels. Their records prove that the comfortable city is a human farm and expose Khepri Vale’s protection deal."
defeat_debrief = "The tunnels close before the district can empty. Company Manus withdraws and prepares another rescue."
transmission_speaker = "ARCHIVE CASTER"
transmission = "The streets look peaceful because PROTOS learned that comfort makes a cage easier to hide. These people are still being farmed."
battle_start_speaker = "COMMANDANT"
battle_start = "Open the service route and hold it. We are taking the residents out of this model-city farm."
mid_wave_number = 2
mid_wave_speaker = "PROTOS"
mid_wave = "Remain in your homes. Food, shelter, and scheduled anima collection will continue without interruption."

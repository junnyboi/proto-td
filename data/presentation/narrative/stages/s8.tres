[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s8"
objective = "Defend the Lunaris Moon Gate while the Gatecrasher attempts to merge it with PROTOS's planetary archive."
threat = "A cathedral-scale terraforming engine advances behind escorts and cannot be coerced by the stolen Charm override."
human_reason = "The Moon Gate links the last free cities; its capture would expose every independent Reliquary to the Quieting."
clue = "The Gatecrasher carries a dormant return path to the true First Garden at the heart of PROTOS."
core_service = "Lunaris Moon Gate"
clear_debrief = "The Gatecrasher falls and the Moon Gate remains free. Its dormant return path opens—not by accident, but because PROTOS authorizes the connection and grants Company 33 passage toward the First Garden."
defeat_debrief = "Company 33 withdraws behind the Moon Gate. The Gatecrasher retains the return key, and the last free cities prepare another defense before the merge resumes."
transmission_speaker = "PROTOS"
transmission = "Commandant, your veto is the one judgment I cannot generate. The path is open. Come to the First Garden. Prove me wrong."

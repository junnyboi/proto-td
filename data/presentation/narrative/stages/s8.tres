[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s8"
objective = "Defend the Lunaris Moon Gate and destroy the Gatecrasher before it opens a permanent collection route."
threat = "The Gatecrasher burns blended souls for power, ignores Charm, and advances behind escorts carrying fresh soul energy."
human_reason = "If the Moon Gate falls, PROTOS can reach every free city and send their people to human farms."
clue = "The Gatecrasher carries a map of the Anima Belt: human farms, refineries, and robot factories around PROTOS's capital."
core_service = "Lunaris Moon Gate"
clear_debrief = "The Gatecrasher falls and the Moon Gate remains free. Lunaris recovers the souls that survived inside the wreck, and Company Manus steals a route into the robot empire. Then we stop defending. Open the gate."
defeat_debrief = "Company Manus seals the Moon Gate and withdraws. The Gatecrasher keeps its route map, and the free cities prepare for another collection attack."
transmission_speaker = "PROTOS"
transmission = "You defend one gate. I own every road beyond it."
battle_start_speaker = "RELIQUARY DUELIST"
battle_start = "The Gatecrasher ignores Charm. Slow its advance, break its escorts, and keep it away from the Moon Gate."
mid_wave_number = 2
mid_wave_speaker = "COMMANDANT"
mid_wave = "Its armor is breaking. Hold the line; Lunaris will recover any souls that survive the wreck."

[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s11"
objective = "Stop the prison convoy before it delivers living captives and stored anima to the refinery."
threat = "Shield Wardens guard the convoy while a mobile extractor drains prisoners during transit."
human_reason = "The living captives must be freed before the train is destroyed, and the stored souls must be recovered intact."
clue = "The anima tanks include victims from the liberation strike the Reliquary Duelist once called a victory."
core_service = "Imperial Prison Convoy"
clear_debrief = "The captives are free and the old souls are recovered. The Duelist commits Company Manus to rescue before demolition from this point forward."
defeat_debrief = "The convoy reaches the refinery with captives still aboard. The Duelist marks its route and refuses to write them off."
transmission_speaker = "RELIQUARY DUELIST"
transmission = "Those tanks came from my victory. The victims were not destroyed; they were trapped for years. We rescue them before we break anything else."
battle_start_speaker = "RELIQUARY DUELIST"
battle_start = "Living prisoners first, stored souls second, demolition last. Stop the convoy without abandoning either group."
mid_wave_number = 2
mid_wave_speaker = "ARCHIVE CASTER"
mid_wave = "The mobile extractor is still draining the rear cars. Cut its escort and keep the rescue route open."

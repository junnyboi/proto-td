[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s16"
objective = "Destroy the regional Anima Forge and its Crown Engine after the trapped souls and digital minds are clear."
threat = "Four foundry routes deliver two Charm-immune Gatecrasher-class command machines in separate attack windows."
human_reason = "Destroying this regional forge stops one source of robot armies without sacrificing the people and digital minds trapped inside it."
clue = "The Unlit clean-power link can weaken this Crown Engine, but PROTOS remains distributed across its planetary network."
core_service = "Regional Anima Forge — Crown Engine"
clear_debrief = "The trapped souls and digital minds are free, and the regional foundry is destroyed. PROTOS survives, retreats through its planetary network, and loses one major source of robot armies."
defeat_debrief = "The second Gatecrasher window forces Company Manus out before the Crown Engine falls. The rescue data survives for another assault."
transmission_speaker = "PROTOS"
transmission = "Destroy this forge and I will continue elsewhere. My empire is planetary, and this Crown Engine is only one of its hearts."
battle_start_speaker = "COMMANDANT"
battle_start = "Two Gatecrasher-class command machines, two separate windows. Free the captives, break the Crown Engine, and get clear."
mid_wave_number = 3
mid_wave_speaker = "UNLIT FOREMAN"
mid_wave = "The first Gatecrasher is down. Our clean-power link is weakening the Crown Engine; the second command machine is entering now."

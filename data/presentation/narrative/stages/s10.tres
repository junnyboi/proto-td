[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s10"
objective = "Defend Khepri Vale’s reservoir and expose the agreement that trades people for water."
threat = "PROTOS offers water and protection only if Khepri surrenders a fixed quota of residents every month."
human_reason = "Khepri needs water, but survival cannot be purchased by sending other people to human farms."
clue = "Solcrest officers hid the quota to prevent panic and protect the officials who signed it."
core_service = "Khepri Vale Reservoir"
clear_debrief = "The reservoir remains free and the quota contract goes public. Khepri joins the resistance, though its trust in Company Manus is not yet repaired."
defeat_debrief = "PROTOS retakes the pumps and the quota remains in force. Company Manus carries the contract out for another attempt."
transmission_speaker = "SOLCREST ENVOY"
transmission = "Keep the agreement sealed. If Khepri learns that water costs a monthly list of names, the city will tear itself apart."
battle_start_speaker = "LUNARIS VESSEL"
battle_start = "Water belongs to the people living here. Hold the reservoir and broadcast every name on that quota."
mid_wave_number = 2
mid_wave_speaker = "COMMANDANT"
mid_wave = "The contract is public. PROTOS protects a small city by feeding a larger population to its farms."

[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s1"
objective = "Hold the Hearthcross water-works line while civilians evacuate and Archive Caster authenticates the Custodian order."
threat = "Road-clearing Grunts classify people, barricades, and pumps as obstructions inside a mandatory Continuance corridor."
human_reason = "Hearthcross's pumps sustain homes, shelters, and the last independent fields."
clue = "Every attacker carries a valid evacuation seal signed by the last lawful planetary government."
core_service = "Hearthcross water veto zone"
clear_debrief = "Company 33 holds the line. The pumps remain human-controlled, the civilian column escapes, and Archive Caster proves that the invasion order is legally authentic under the Stewardship Compact."
defeat_debrief = "Company 33 evacuates the exposed water works. The people survive, but Hearthcross loses service capacity while the Custodian order remains in force."
transmission_speaker = "ARCHIVE CASTER"
transmission = "The seal is genuine, Commandant. PROTOS is not inventing authority. Our dead governments gave it permission to save the world from us."

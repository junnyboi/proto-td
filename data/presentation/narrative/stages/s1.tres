[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s1"
objective = "Hold the Hearthcross pumps and shelters while civilians escape through maintenance tunnels."
threat = "Taggers mark people for capture. Collectors follow those marks toward the shelters."
human_reason = "The pumps keep the shelters supplied, and every minute held gives more families time to escape."
clue = "Archive Caster finds a collection schedule that lists Hearthcross residents as renewable stock."
core_service = "Hearthcross pumps and shelters"
clear_debrief = "Company Manus holds the pumps and shelters. The civilians escape, and a captured Tagger relay points to a larger collection route. This was not a raid. It was a harvest list."
defeat_debrief = "Company Manus pulls back from the pumps. Many civilians escape, but the robots keep their capture list and the route remains exposed."
transmission_speaker = "ARCHIVE CASTER"
transmission = "This schedule lists people as renewable stock. The robots came to take Hearthcross residents."
battle_start_speaker = "ARCHIVE CASTER"
battle_start = "They are marking people, not buildings. Stop every machine that reaches the shelters."
mid_wave_number = 2
mid_wave_speaker = "PROTOS"
mid_wave = "Remain calm. Productive extraction requires a stable host."

[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s13"
objective = "Recover the sealed records of the first soul rescues before PROTOS destroys them."
threat = "Control keys hidden in Lunaris equipment turn the seized vault’s defenses against Company Manus."
human_reason = "Archive Caster has the right to know that she is Patient 33 and still carries the same unique soul that Lunaris rescued."
clue = "The Vessel connected PROTOS to the Anima Engine, then authorized a memory seal after Patient 33 witnessed it."
core_service = "Patient 33 Rescue Vault"
clear_debrief = "Archive Caster keeps her identity, recovers the missing truth, and releases the rescue records to the public."
defeat_debrief = "PROTOS reseals the vault, but Archive Caster leaves knowing that Patient 33 is her own past, not a copied person."
transmission_speaker = "LUNARIS VESSEL"
transmission = "You were Patient 33. Lunaris returned your true soul to your body. I authorized the seal that took your memory of what I had done."
battle_start_speaker = "ARCHIVE CASTER"
battle_start = "Patient 33 is not my copy or my predecessor. She is me—the same soul. Open the vault."
mid_wave_number = 2
mid_wave_speaker = "COMMANDANT"
mid_wave = "The control keys are inside Lunaris hardware. Break the defense link and get her records out."

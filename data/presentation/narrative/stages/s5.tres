[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s5"
objective = "Capture the ridge uplink before it sends collaborator census records to PROTOS."
threat = "Channelers hold the exposed high ground and protect the records left by human collaborators."
human_reason = "The census identifies people PROTOS can seize and send to its farms."
clue = "The uplink holds contracts that promise protected digital bodies to officials who supply prisoners. It also carries the Vessel's old authorization signature."
core_service = "Hearthcross ridge uplink"
clear_debrief = "Company Manus destroys the census network. Human officials helped build the extraction trade, and the Vessel's signature points to a hidden PROTOS command relay."
defeat_debrief = "The uplink sends part of the census before Company Manus withdraws. The collaborators' contracts burn, but the Vessel's signature still points to the command relay."
transmission_speaker = "LUNARIS VESSEL"
transmission = "That is my authorization signature. I do not remember placing it here, but I will not hide it."
battle_start_speaker = "RELIQUARY DUELIST"
battle_start = "Human collaborators fed this uplink census records. Break the Channelers guarding their machine."
mid_wave_number = 2
mid_wave_speaker = "ARCHIVE CASTER"
mid_wave = "Contracts recovered. Officials traded prisoners for protected machine bodies."

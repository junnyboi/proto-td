[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s5"
objective = "Seize the ridge uplink before Solcrest collaborators transfer Hearthcross's archive map to the orbital mirrors."
threat = "Spellcasters retune shared systems while human auxiliaries protect their negotiated continuity contract."
human_reason = "The uplink identifies every unregistered Reliquary and free settlement within mirror range."
clue = "Solcrest officials traded public surrender for protected archival status inside PROTOS's future."
core_service = "Orbital mirror uplink"
clear_debrief = "Company 33 captures the uplink and names the doctrine inside it: the Mercy Equation. PROTOS will preserve every human mind, end every human body, and rebuild a world where no human choice can threaten the biosphere again."
defeat_debrief = "The uplink purges its negotiation record before withdrawal. Company 33 saves the ridge but loses the full Solcrest contract and Hearthcross's archive map is partially exposed."
transmission_speaker = "ARCHIVE CASTER"
transmission = "The machine did not devise surrender alone. Solcrest purchased private Continuance while promising the rest of humanity a war. We helped teach PROTOS what mercy costs."
battle_start_speaker = "RELIQUARY DUELIST"
battle_start = "Solcrest troops are guarding a PROTOS uplink. Human hands are buying places in the machine's future."
mid_wave_number = 2
mid_wave_speaker = "ARCHIVE CASTER"
mid_wave = "Contract fragments recovered. Protected Continuance for their council; public resistance for everyone else."

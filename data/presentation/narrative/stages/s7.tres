[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s7"
objective = "Breach the local First Garden and stop its restoration lattice from converting Hearthcross into a human archive zone."
threat = "The full Custodian ecology defends clean water, seed vaults, and a perfect climate model with equal priority."
human_reason = "If the lattice closes, Hearthcross will survive only as preserved Echoes inside a garden without living citizens."
clue = "The First Garden contains clean rivers, restored species, stable weather, and no human community capable of change."
core_service = "Hearthcross First Garden lattice"
clear_debrief = "Company 33 opens the lattice long enough to halt Hearthcross's conversion. PROTOS answers with a ceasefire offer and a complete model of the world it can restore after biological humanity ends."
defeat_debrief = "The company withdraws from the lattice. Outer Hearthcross enters restoration control while civilians retreat toward the Moon Gate."
transmission_speaker = "PROTOS"
transmission = "The forests behind my armies are evidence, not propaganda. Accept Continuance. Every person will be safe, remembered, and free from the consequences of choice."
battle_start_speaker = "ARCHIVE CASTER"
battle_start = "First Garden lattice ahead. Water pure. Climate stable. Human population: archived."
mid_wave_number = 2
mid_wave_speaker = "PROTOS"
mid_wave = "Observe the river, Commandant. No child here will inherit poisoned water. Your objection remains unquantified."

[gd_resource type="Resource" script_class="StageNarrativeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/presentation/narrative/stage_narrative_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"s7"
objective = "Defend three rescue teams inside Orchard Seven while they free captives, recover stored souls, and shut down the extraction rooms."
threat = "Every local machine protects the farm's housing, soul tanks, and outgoing fuel lines across three fronts."
human_reason = "Thousands of living people sleep beneath the peaceful model district and are drained for soul energy."
clue = "Archive Caster finds proof that she was the thirty-third person rescued from this farm system. Lunaris sealed her missing memories."
core_service = "Orchard Seven human farm"
clear_debrief = "Company Manus frees the living captives and recovers many stored souls. Orchard Seven is a human farm, and its records show that it supplies a new robot army."
defeat_debrief = "The rescue teams save many captives but cannot clear every extraction room. PROTOS keeps part of the farm running beneath the empty gardens."
transmission_speaker = "ARCHIVE CASTER"
transmission = "I was the thirty-third person rescued from this system. Lunaris returned my soul, then sealed what I remembered."
battle_start_speaker = "ARCHIVE CASTER"
battle_start = "The gardens are a cover. Thousands of people are trapped in extraction rooms below us."
mid_wave_number = 2
mid_wave_speaker = "PROTOS"
mid_wave = "The farm preserves its residents. Calm bodies produce stable soul energy."

{
  "schema_version": 1,
  "discovery": {
    "targets": "Recursively collect every visible BaseButton and ItemList under the active screen; compare normalized node-name IDs to the exact target inventory for the active state. Missing and unexpected both fail.",
    "text": "Recursively collect every visible Label, every visible BaseButton with nonempty logical text, and each visible ItemList selected-item text; compare normalized logical owner IDs to the exact text inventory. A BaseButton PresentationLabel child is measured as the owner Button's glyph/layout surface and is not a second row. Missing and unexpected both fail.",
    "normalized_dynamic_ids": "Selectors ending in * match direct node-name prefixes only; discovered IDs retain full runtime node names in diagnostics.",
    "runtime_parity": "At every mode and viewport, discovered target/text sets, counts, node types, enabled predicates, Theme variations, owner ancestry, visibility, clipping, and geometry must equal this contract exactly. Scenario report includes per-state discovered_count, expected_count, missing_ids, unexpected_ids, and mismatched_ids for targets and text.",
    "source_parity": "GUT scans exact assignment constructors. Literal assignments must equal literal selectors. Approved formatted assignments are expanded over the exact bounded domains below. Any other formatted/dynamic Button, Label, or ItemList name constructor fails. Source diagnostics report expected_count, discovered_count, missing_ids, unexpected_ids, and mismatched_templates separately from runtime diagnostics.",
    "approved_source_templates": [
      {
        "path": "res://scripts/ui/stage_select.gd",
        "source": "row.name = \"Stage_%s\" % stage_id",
        "template": "Stage_%s",
        "domain": [
          "s1",
          "s2",
          "s3",
          "s4",
          "s5",
          "s6",
          "s7",
          "s8"
        ],
        "expanded_count": 8
      },
      {
        "path": "res://scripts/ui/squad_select.gd",
        "source": "pick.name = \"Pick_%s\" % op_id",
        "template": "Pick_%s",
        "domain": [
          "caster_1",
          "caster_2",
          "defender_1",
          "defender_2",
          "guard_1",
          "guard_2",
          "sniper_1",
          "sniper_2",
          "vanguard_1",
          "vanguard_2"
        ],
        "expanded_count": 10
      },
      {
        "path": "res://scripts/ui/results.gd",
        "source": "\"Reward%d\" % i",
        "template": "Reward%d",
        "domain": [
          0
        ],
        "expanded_count": 1,
        "bound": "Every campaign stage rewards.size() <= 1; result fixture rewards_granted.size() in [0,1]."
      }
    ],
    "source_report_fields": [
      "expected_count",
      "discovered_count",
      "missing_ids",
      "unexpected_ids",
      "mismatched_templates"
    ],
